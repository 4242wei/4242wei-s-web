# Optional local path overrides
# Leave blank to use the project's built-in local defaults.

REPORTS_DIR=
STOCKS_DATA_PATH=
STOCKS_UPLOADS_DIR=
TRANSCRIPT_UPLOADS_DIR=
TRANSCRIPT_PDF_ARCHIVE_DIR=
AI_CHAT_DATA_PATH=
AI_CONTEXT_DIR=
EXPERT_INTAKE_PROVIDER_CONFIG=
MONITOR_SOURCE_DIR=
ORIGINAL_MONITOR_CONFIG_PATH=
SECURITY_SOFTWARE_DAILY_WRITER_SKILL_DIR=
AGENT_PAYMENT_DIR=
AISA_X402_SKILL_SCRIPT=
AISA_X402_PYTHON=
TRANSCRIPT_PDF_FONT_PATHS=
TRANSCRIPT_DIRECT_OSS_UPLOAD_ENABLED=0
TRANSCRIPT_BACKGROUND_PIPELINE_ENABLED=0

# Optional Tingwu / OSS credentials
# Keep these only in your local .env.local and never commit them.

ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_TINGWU_APP_KEY=
ALIYUN_TINGWU_ENDPOINT=tingwu.cn-beijing.aliyuncs.com
ALIYUN_TINGWU_REGION_ID=cn-beijing
ALIYUN_TINGWU_API_VERSION=2023-09-30
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_REGION_ID=cn-beijing
ALIYUN_OSS_BUCKET=

# Optional LLM provider credentials for expert smart intake.
# Keep the real value in .env.local only.
DEEPSEEK_API_KEY=

# Optional read-only Outlook Calendar sync. The private ICS URL is saved in data/
# by the authenticated settings UI; no Mail or Microsoft Graph permission is used.
OUTLOOK_CALENDAR_BACKGROUND_ENABLED=1
OUTLOOK_CALENDAR_POLL_SECONDS=14400
OUTLOOK_CALENDAR_CONFIG_PATH=
OUTLOOK_CALENDAR_CACHE_PATH=
EXPERT_LINK_SCAN_SECONDS=14400
EXPERT_LINK_BACKGROUND_ENABLED=1
EXPERT_INTERVIEW_LINK_CACHE_PATH=
